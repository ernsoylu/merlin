{
  "schemaVersion": "2.2.0",
  "interface": {
    "name": "EnvironmentalData", "version": "1.1.0", "kind": "sample-group",
    "elements": [
      {"name": "Temperature", "type": "float32", "unit": "degC", "range": [-40.0, 85.0]},
