# Pinned toolchain. Single source of truth: read by install.sh (shell) and by
# scripts/wizard/core/env.py (check-env). Plain KEY=value, no quotes, no
# expansion, no spaces around '=' -- both readers depend on that.
ESP_IDF_VERSION=5.2.3
ESP_IDF_TARGET=esp32
PYTHON_MIN=3.10
QEMU_TOOL=qemu-xtensa
GCC_PREFIX=xtensa-esp32-elf
